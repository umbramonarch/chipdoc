{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start_hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_read_pdf_hook.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_read_pdf_hook.py\""
          }
        ]
      }
    ]
  }
}
