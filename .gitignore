# Rust / Cargo build artifacts
/target/
**/*.rs.bk

# Runtime PDFium shared libraries
/bin/*.dll
/bin/*.so
/bin/*.dylib
/pdfium.dll
/libpdfium.so
/libpdfium.dylib

# Local PDF test corpus (keep README.md tracked)
/samples/*.pdf

# Temporary output directory (`output/` is tracked in git; `.claudeignore` excludes `output/` from prompt context)
/out/

# Environment & IDE
.env
.vscode/
.idea/
*.swp
*.log
.DS_Store
Thumbs.db
